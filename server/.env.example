# ============================================================================
#  SBPO Link Tree server: every setting in one place.
#  Local:  copy this file to server/.env and edit.
#  Render: add the same names under  Environment  (never commit real secrets).
# ============================================================================

# ---- Server ----------------------------------------------------------------
# Render sets PORT for you. Locally 3000 is fine.
PORT=3000

# Set to 1 when running behind a proxy (Render, Caddy, Nginx). Needed for the real client IP and HTTPS detection.
# Leave it off on your own computer.
# TRUST_PROXY=1

# ---- Database --------------------------------------------------------------
# MongoDB Atlas connection string (Render has no built-in MongoDB). Locally you can use a local MongoDB.
# In Atlas: Network Access must allow your server (Render's addresses change, so "0.0.0.0/0" is the usual choice).
MONGODB_URI=mongodb://127.0.0.1:27017/sbpo-link-tree
# Only if you want a different database name than the one in the URI.
# MONGODB_DB=sbpo-link-tree

# ---- Admin login -----------------------------------------------------------
ADMIN_USER=admin
# Use a long password. If left empty, a random one is printed in the server log on every start.
ADMIN_PASSWORD=change-me
# How long a sign-in lasts (days).
# SESSION_DAYS=7

# ---- Frontend (the React app on Vercel) ------------------------------------
# Address(es) of the deployed frontend, exactly as shown in the browser: scheme + host, no path, no trailing slash.
# Several: separate with commas. REQUIRED in production:
#   - lets the browser call the API with the login cookie (CORS)
#   - blocks other websites from sending changes as the logged-in admin
#   - "/" on the server redirects here
# Local development with the Vite dev server: http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# How the frontend reaches this server:
#   strict (default) - through the Vercel rewrites in frontend/vercel.json (same origin). Recommended.
#   none             - the browser calls this server directly from another site (frontend sets VITE_API_URL).
#                      The cookie is then Secure + SameSite=None, which Safari and some browsers block as a
#                      "third-party cookie" unless both sites share one parent domain (app.x.com + api.x.com).
#   lax              - same parent domain over HTTPS and you prefer a looser setting than strict.
COOKIE_SAMESITE=strict
# Normally automatic (Secure when the request came in over HTTPS). Force with 1 or 0 only if needed.
# COOKIE_SECURE=1

# ---- Old data -------------------------------------------------------------
# data.json from the previous version. Imported once, only when the database is completely empty.
# LEGACY_DATA_FILE=./data/legacy-data.json
