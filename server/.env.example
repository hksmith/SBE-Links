# Copy this file to .env and adjust.
PORT=3000

# Local MongoDB (Windows: install "MongoDB Community Server"), or paste a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/sbpo-link-tree

ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Set to 1 when running behind a reverse proxy (Caddy / Nginx)
# TRUST_PROXY=1

# Old data.json to import automatically the first time the database is empty
# LEGACY_DATA_FILE=./data/legacy-data.json
