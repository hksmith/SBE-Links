# ===== Frontend settings (Vercel → Project → Settings → Environment Variables) =====
# Only variables starting with VITE_ reach the browser. Never put secrets here.

# The server's public address (Render). Where /n/<slug> and /<slug> pages live.
# Used for "Copy NFC link", "Open page" and the live preview.
VITE_PUBLIC_URL=https://sbpo-api.onrender.com

# Leave EMPTY (recommended): the browser calls this site's own /api, /login, /logout, /media and the rewrites in
# vercel.json forward them to the server.
# Set it only to call the server directly (then the server needs COOKIE_SAMESITE=none, see server/.env.example).
# VITE_API_URL=https://sbpo-api.onrender.com

# Local development only: where `npm run dev` forwards the API paths.
# DEV_BACKEND_URL=http://localhost:3000
